PORT=8000
CORS_ORIGIN=*
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRY=10d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
NODE_ENV=development
# Same value as the frontend's VITE_GOOGLE_CLIENT_ID — required audience for verifying Google ID tokens.
GOOGLE_CLIENT_ID=
# Shared secret gating self-service admin signup. Leave blank to disable admin self-signup entirely.
ADMIN_SIGNUP_CODE=
